{
  "name": "@dedok/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../../.env dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dedok/database": "workspace:*",
    "@dedok/indicators": "workspace:*",
    "@dedok/shared": "workspace:*",
    "@fastify/cors": "11.1.0",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.10.0",
    "pino": "9.7.0",
    "zod": "4.0.14"
  },
  "devDependencies": {
    "tsx": "4.20.3",
    "vitest": "3.2.4"
  }
}
